<plugin>
    <name>os-yori</name>
    <version>0.4.0</version>
    <tier>community</tier>
    <comment>Zero-trust LLM Gateway for home networks</comment>
    <maintainer>apathy-ca</maintainer>
    <www>https://github.com/apathy-ca/yori</www>
    <name>YORI LLM Gateway</name>
    <type>service</type>
    <depends>
        <depend type="package">python311</depend>
        <depend type="package">py311-sqlite3</depend>
    </depends>
    <configure>
        <template>OPNsense/YORI</template>
    </configure>
    <service>
        <name>yori</name>
        <description>YORI LLM Gateway Service</description>
        <configd>
            <restart>yori restart</restart>
            <start>yori start</start>
            <stop>yori stop</stop>
        </configd>
    </service>
</plugin>
